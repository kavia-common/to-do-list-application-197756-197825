# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization
